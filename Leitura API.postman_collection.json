								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200) {",
											"    var jsonData = pm.response.json();",
											"    pm.environment.set('jwt_token', jsonData.token);",
											"    console.log('Token JWT salvo automaticamente');",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"email\": \"admin@leitura.com\",\n  \"senha\": \"admin123\"\n}"
								},
								"url": "{{localhost}}/login",
								"description": "Endpoint para autenticação. Retorna um token JWT que será usado automaticamente nas próximas requisições."
							},
							"response": []
						}
