					"name": "Autenticação",
					"item": [
						{
							"name": "Login",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200) {",
											"    var jsonData = pm.response.json();",
											"    pm.environment.set('jwt_token', jsonData.token);",
											"    pm.environment.set('user_id', jsonData.id);",
											"    console.log('Token JWT e User ID salvos automaticamente');",
											"    console.log('User ID: ' + jsonData.id);",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"email\": \"admin@leitura.com\",\n  \"senha\": \"admin123\"\n}"
								},
								"url": "{{localhost}}/usuarios/login",
								"description": "Endpoint para autenticação. Retorna um token JWT que será usado automaticamente nas próximas requisições."
							},
							"response": []
						}
					]
				},
