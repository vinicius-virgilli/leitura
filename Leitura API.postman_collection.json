	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Script executado antes de cada requisição",
					"// Verifica se o token JWT está disponível",
					"if (pm.environment.get('jwt_token')) {",
					"    console.log('Token JWT disponível para autenticação');",
					"} else {",
					"    console.log('Token JWT não encontrado. Execute o login primeiro.');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Script executado após cada requisição",
					"// Log do status da resposta",
					"console.log('Status da resposta:', pm.response.code);",
					"if (pm.response.code === 401) {",
					"    console.log('Token JWT expirado ou inválido. Execute o login novamente.');",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "localhost",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "production",
			"value": "https://leitura.fly.dev",
			"type": "string",
			"description": "URL de produção da API"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string",
			"description": "Token JWT obtido após login - preenchido automaticamente"
		}
	]
